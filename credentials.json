function timKiemHoacKiemTraTrungLap() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sheet = ss.getActiveSheet();
  
  // Nếu đang đứng ở sheet KHO_PHAN_BO hoặc các sheet phân bổ, tự động chạy tính năng CHECK TRÙNG tự động
  var sheetName = sheet.getName();
  if (sheetName === "KHO_PHAN_BO") {
    var data = sheet.getDataRange().getValues();
    if (data.length < 3) {
      ss.toast("Chưa có dữ liệu để kiểm tra trùng lặp!", "Thông báo", 3);
      return;
    }
    
    var seen = {};
    var duplicateRows = [];
    
    // Quét từ dòng 3 để tìm trùng lặp (Kết hợp Mã dự án + Mã SKU + Đơn vị nhận)
    for (var i = 2; i < data.length; i++) {
      var row = data[i];
      var maDa = String(row[0]).trim();
      var maSku = String(row[1]).trim();
      var doiNhan = String(row[7]).trim(); // Cột H: Đơn vị nhận
      
      if (maSku && doiNhan) {
        var key = maDa + "_" + maSku + "_" + doiNhan;
        if (seen[key]) {
          duplicateRows.push(i + 1); // Lưu lại số dòng bị trùng
        } else {
          seen[key] = i + 1;
        }
      }
    }
    
    // Hiển thị kết quả check trùng trực quan
    var ui = SpreadsheetApp.getUi();
    if (duplicateRows.length > 0) {
      ui.alert("⚠️️ CẢNH BÁO PHÂN BỔ TRÙNG LẶP!\n\nPhát hiện các dòng bị trùng thiết bị cho cùng một đơn vị nhận tại các dòng: " + duplicateRows.join(", ") + "\n\nAnh cần kiểm tra lại ngay để tránh cấp phát sai!");
    } else {
      ss.toast("✅ Kiểm tra hoàn tất: Không có dữ liệu phân bổ bị trùng lặp!", "An toàn", 4);
    }
  } else {
    // Nếu ở sheet khác, dùng ô E1 làm ô tìm kiếm nhanh thông thường
    var searchVal = sheet.getRange("E1").getValue();
    if (!searchVal) {
      SpreadsheetApp.getUi().alert("Vui lòng nhập từ khóa vào ô màu vàng (E1) để tìm kiếm!");
      return;
    }
    var data = sheet.getDataRange().getValues();
    var found = 0;
    for (var i = 0; i < data.length; i++) {
      for (var j = 0; j < data[i].length; j++) {
        if (String(data[i][j]).toLowerCase().indexOf(String(searchVal).toLowerCase()) !== -1) {
          found++;
          break;
        }
      }
    }
    ss.toast("Tìm thấy " + found + " kết quả khớp với từ khóa.", "Tìm kiếm", 3);
  }
}
