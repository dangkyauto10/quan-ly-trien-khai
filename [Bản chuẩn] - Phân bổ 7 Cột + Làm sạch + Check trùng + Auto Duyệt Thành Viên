// 2. HÀM LÀM SẠCH HỆ THỐNG
// ==========================================
function resetHeThong() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var ui = SpreadsheetApp.getUi();
  var xacNhan = ui.alert('XÁC NHẬN LÀM SẠCH', 'Bạn có chắc chắn muốn xóa TOÀN BỘ dữ liệu phân bổ hiện tại (từ dòng 3 trở xuống) không?', ui.ButtonSet.YES_NO);
  if (xacNhan == ui.Button.YES) {
    var danhSachSheet = ["KHO_PHAN_BO", "VAN_CHUYEN", "LAP_DAT"];
    for (var i = 0; i < danhSachSheet.length; i++) {
      var sheet = ss.getSheetByName(danhSachSheet[i]);
      if (sheet && sheet.getMaxRows() >= 3) sheet.getRange(3, 1, sheet.getMaxRows() - 2, sheet.getMaxColumns()).clearContent();
    }
    ui.alert("✅ HOÀN TẤT", "Hệ thống đã được làm sạch!", ui.ButtonSet.OK);
  }
}

// ==========================================
// 3. HÀM KIỂM TRA TRÙNG LẶP (7 CỘT)
// ==========================================
function checkTrungLapPhanBo() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sheetKho = ss.getSheetByName("KHO_PHAN_BO");
  if (!sheetKho) return;
  var lastRow = sheetKho.getLastRow();
  if (lastRow < 3) return SpreadsheetApp.getUi().alert("Không có dữ liệu để kiểm tra!");
  sheetKho.getRange(3, 1, lastRow - 2, 7).setBackground(null);
  var data = sheetKho.getRange(3, 1, lastRow - 2, 7).getValues();
  var tracker = {}, duplicateRows = [];
  for (var i = 0; i < data.length; i++) {
    var maDA = String(data[i][0]).trim(), maTB = String(data[i][1]).trim(), diaDiem = String(data[i][6]).trim();
    if (maDA === "" || maTB === "" || diaDiem === "") continue;
    var key = maDA + "_" + maTB + "_" + diaDiem;
    if (tracker[key]) {
      duplicateRows.push(i + 3); 
      if (duplicateRows.indexOf(tracker[key]) === -1) duplicateRows.push(tracker[key]); 
    } else tracker[key] = i + 3;
  }
  if (duplicateRows.length > 0) {
    for (var d = 0; d < duplicateRows.length; d++) sheetKho.getRange(duplicateRows[d], 1, 1, 7).setBackground("#f4c7c3");
    SpreadsheetApp.getUi().alert("⚠️ PHÁT HIỆN TRÙNG LẶP\n\nCó " + duplicateRows.length + " dòng dữ liệu bị phân bổ trùng.");
  } else SpreadsheetApp.getUi().alert("✅ HOÀN TẤT\n\nHệ thống sạch sẽ!");
}

// ==========================================
// 4. TRIGGER TỰ ĐỘNG CHUYỂN DỮ LIỆU KHI DUYỆT THÀNH VIÊN
// ==========================================
function onEdit(e) {
  if (!e || !e.range) return;
  var sheet = e.range.getSheet();
  if (sheet.getName() === "DANG_KY_THANH_VIEN" && e.range.getColumn() === 7) {
    var row = e.range.getRow();
    if (row < 3 || e.value !== "Đã duyệt") return; 
    var sheetQuanLy = e.source.getSheetByName("QUAN_LY_DOI");
    if (!sheetQuanLy) return;
    var hoTen = sheet.getRange(row, 2).getValue(), chuyenMon = sheet.getRange(row, 5).getValue();
    if (hoTen === "") return;
    var qlData = sheetQuanLy.getDataRange().getValues(), isExist = false;
    for (var i = 2; i < qlData.length; i++) {
      if (String(qlData[i][1]).trim() === String(hoTen).trim()) { isExist = true; break; }
    }
    if (!isExist) {
      var maDoi = "KTV-" + Math.floor(1000 + Math.random() * 9000);
      var lastRowQL = sheetQuanLy.getLastRow();
      var nextRow = lastRowQL < 2 ? 3 : lastRowQL + 1; 
      sheetQuanLy.getRange(nextRow, 1, 1, 3).setValues([[maDoi, hoTen, chuyenMon]]);
      sheet.getRange(row, 8).setValue(hoTen);
    }
  }
}
