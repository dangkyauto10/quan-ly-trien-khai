// 1. HÀM PHÂN BỔ ALLOCATION SYNC (CHUẨN 7 CỘT TỐI ƯU)
// ==========================================
function thucHienPhanBoTuDMChuan() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sheetDM = ss.getSheetByName("DM_CHUAN");
  var sheetKho = ss.getSheetByName("KHO_PHAN_BO");
  var sheetVC = ss.getSheetByName("VAN_CHUYEN");
  var sheetLD = ss.getSheetByName("LAP_DAT");
  var sheetDA = ss.getSheetByName("DANH_SACH_DU_AN");
  if (!sheetDM) return;
  var lastRow = sheetDM.getLastRow();
  if (lastRow < 3) return;
  
  var dmData = sheetDM.getRange(3, 1, lastRow - 2, 6).getValues();
  var daData = sheetDA ? sheetDA.getDataRange().getValues() : [];
  var danhSachThietBi = [];
  var danhSachXa = [];
  
  for (var i = 0; i < dmData.length; i++) {
    var maDuAn = String(dmData[i][0]).trim(); 
    var maTB   = String(dmData[i][1]).trim(); 
    var tenTB  = String(dmData[i][2]).trim(); 
    var dvt    = String(dmData[i][3]).trim(); 
    var sl     = String(dmData[i][4]).trim(); 
    var xa     = String(dmData[i][5]).trim(); 
    if (maDuAn !== "" && maTB !== "") danhSachThietBi.push({maDuAn: maDuAn, maTB: maTB, tenTB: tenTB, dvt: dvt, sl: sl});
    if (xa !== "") {
      var xaArr = xa.split(/[\n,]+/);
      for (var j = 0; j < xaArr.length; j++) {
        var tenXa = xaArr[j].trim();
        if (tenXa !== "" && danhSachXa.indexOf(tenXa) === -1) danhSachXa.push(tenXa);
      }
    }
  }
  if (danhSachThietBi.length === 0 || danhSachXa.length === 0) {
    SpreadsheetApp.getUi().alert("LỖI: Trống Thiết bị (Cột A) hoặc Danh sách Xã (Cột F)!");
    return;
  }
  var khoRows = [], vcRows = [], ldRows = [];
  for (var x = 0; x < danhSachXa.length; x++) {
    var tenXaHienTai = danhSachXa[x];
    for (var t = 0; t < danhSachThietBi.length; t++) {
      var tb = danhSachThietBi[t];
      var rc = Math.floor(100000 + Math.random() * 900000);
      var tenDAThucTe = "Dự án " + tb.maDuAn;
      for (var d = 0; d < daData.length; d++) {
        if (String(daData[d][0]).trim() === tb.maDuAn) { tenDAThucTe = String(daData[d][1]).trim(); break; }
      }
      khoRows.push([tb.maDuAn, tb.maTB, tenDAThucTe, tb.tenTB, tb.dvt, tb.sl, tenXaHienTai]);
      vcRows.push([tb.maDuAn, "VC-" + rc, "", tb.tenTB + " (" + tb.dvt + ")", tb.sl, tenXaHienTai, "", ""]);
      ldRows.push(["LD-" + rc, tb.maDuAn, "", tb.tenTB, tb.sl, tb.dvt, tenXaHienTai, "", "", ""]);
    }
  }
  function writeDataAppend(sheet, data, numCols) {
    if (!sheet || data.length === 0) return;
    var currentLastRow = sheet.getLastRow();
    var startRow = currentLastRow < 2 ? 3 : currentLastRow + 1; 
    var requiredRows = startRow + data.length - 1;
    if (sheet.getMaxRows() < requiredRows) sheet.insertRowsAfter(sheet.getMaxRows(), requiredRows - sheet.getMaxRows() + 50);
    sheet.getRange(startRow, 1, data.length, numCols).setValues(data);
  }
  var msg = "ALLOCATION SYNC (7 CỘT) ĐÃ THÀNH CÔNG:\n👉 Phân bổ thêm: " + danhSachThietBi.length + " thiết bị x " + danhSachXa.length + " đơn vị.\n";
  try { writeDataAppend(sheetKho, khoRows, 7); msg += "✅ KHO_PHAN_BO: OK\n"; } catch(e) { msg += "❌ Lỗi KHO: " + e.message + "\n"; }
  try { writeDataAppend(sheetVC, vcRows, 8); msg += "✅ VAN_CHUYEN: OK\n"; } catch(e) { msg += "❌ Lỗi VC: " + e.message + "\n"; }
  try { writeDataAppend(sheetLD, ldRows, 10); msg += "✅ LAP_DAT: OK\n"; } catch(e) { msg += "❌ Lỗi LĐ: " + e.message + "\n"; }
  SpreadsheetApp.getUi().alert(msg);
}

